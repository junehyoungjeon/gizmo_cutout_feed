
fn
with h5py.File(fn,'r') as f:
    for pt in range(6):
        g = f.get(f'PartType{pt}')
        if g is None: continue
        if 'Masses' in g:
            print(pt, "Masses dtype:", g['Masses'].dtype, "shape:", g['Masses'].shape)
        else:
            print(pt, "no Masses; header mass table entry:", f['Header'].attrs['MassTable'][pt])
